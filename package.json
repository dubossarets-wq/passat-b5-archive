{
  "name": "passat-b5-archive",
  "version": "2.0.0",
  "private": true,
  "description": "Справочник по VW Passat B5 1.8 20V (ARG): коды ошибок, статьи, электросхемы, запчасти, регламент",
  "type": "module",
  "main": "src/main.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.js",
    "build": "node --disable-warning=ExperimentalWarning src/build.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/*.test.js\"",
    "check-links": "node --disable-warning=ExperimentalWarning src/cli/check-links.js --all"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "fastify": "^5.12.8",
    "markdown-it": "^15.0.3",
    "yaml": "^2.9.1"
  }
}
